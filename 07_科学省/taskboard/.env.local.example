# Cursor Dashboard → Integrations で発行したAPIキー
CURSOR_API_KEY="cursor_ここに自分のキー"

# 任意。未指定ならCursor側が利用可能モデルを選ぶ(AI尊徳・スマートラビット共通)
SONTOKU_MODEL="auto"

# 任意。imada-knowledge Vaultの場所(スマートラビットのKnowledge検索用)。
# 既定値は ai-imadaruma と兄弟ディレクトリの （リポジトリ内）08_情報省/imada-knowledge。
# IMADA_KNOWLEDGE_VAULT_PATH="/Users/you/ai-imadaruma/08_情報省/imada-knowledge"

# 任意。既定は0.0.0.0（全ネットワークインターフェースで待受＝携帯からLANアクセス可）。
# Mac本体からしか使わないなら "127.0.0.1" にするとLAN待受自体を止められる。
# HOST="0.0.0.0"

# 任意。既定は8765
# PORT="8765"

# 携帯からLAN/Tailscale経由でアクセスするなら実質必須。
# 未設定の場合、/api/state・/api/sontoku・/api/smart-rabbit・/api/appointments へのアクセスは
# Mac本体（localhost）からのみ許可され、LAN上の他端末からは拒否される。
# 設定する場合は openssl rand -hex 32 などで生成した長い値を使うこと。
TASKBOARD_TOKEN=""

# Googleカレンダー連携（詳細: GOOGLE_CALENDAR.md）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8765/api/gcal/callback"
# GOOGLE_CALENDAR_ID="primary"
GCAL_REMINDERS_MINUTES="1440,180,90"
